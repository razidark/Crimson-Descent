{
  "name": "crimson-descent",
  "private": true,
  "version": "1.0.0",
  "description": "Gothic side-scroller idle RPG played on a simulated desktop OS taskbar (RZL Apps)",
  "author": "RZL Apps",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "build:exe": "pnpm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.rzlapps.crimsondescent",
    "productName": "Crimson Descent",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.12"
  }
}
