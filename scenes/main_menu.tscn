[node name="Desc" type="Label" parent="InstructionsPanel/VBox"]
layout_mode = 2
text = "• WASD / Arrow Keys: Move  |  Space: Spectral Dash
• Left Click (Hold or Tap): Attack toward cursor
• [1-4] or [Q]: Switch Weapons (Sword, Daggers, Bow, Staff)
• [E]: Class Signature Ultimate  |  Mouse Wheel: Zoom
• [C] / [I] / [TAB]: Relics Backpack & Survival Forge
• [F]: Drink Potion  |  [G]: Place Hunting Spike Trap
• [R]: Descend Portal (after defeating Floor Boss)
• [M]: Toggle Audio  |  [ESC]: Pause"
autowrap_mode = 2

